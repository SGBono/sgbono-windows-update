<Window x:Class="sgbono_windows_update.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sgbono_windows_update"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.IsIconVisible="True"
        ui:ThemeManager.RequestedTheme="Default"
        ui:WindowHelper.SystemBackdropType="Mica"
        mc:Ignorable="d"
        Title="OS Update" Height="500" Width="700" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Orientation="Vertical">
            <ui:InfoBar x:Name="homeEditionError" Title="This computer is running Windows 11 Home. Update this one manually." Severity="Error" IsOpen="True" IsClosable="False" HorizontalAlignment="Center" Height="50" FontFamily="Segoe UI Variable Display" Visibility="Collapsed"/>
            <ui:InfoBar x:Name="reminderWarning" Title="Please remember to disconnect from the update server when done." Severity="Warning" IsOpen="True" IsClosable="False" HorizontalAlignment="Center" Height="50" FontFamily="Segoe UI Variable Display" Visibility="Collapsed"/>
            <StackPanel Margin="0,0,0,20">
                <Label Content="SGBono Windows Update" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Margin="40,20,0,5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label Content="Configure Automated Update options." FontSize="14" Margin="40,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,20">
                <!--<Label Content="This computer is running Windows 11 Home. Update this one manually." FontFamily="Segoe UI Variable Display" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,0,0,5" Foreground="#FFF000"/>-->
                <Label Content="Start Here" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,0,0,5" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display"/>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <Button x:Name="connectButton" Content="Connect" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,10,0" Click="connectButton_Click"/>
                    <Button x:Name="disconnectButton" Content="Disconnect" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="40,0,0,5">
                    <Label Content="Status: " FontSize="16"/>
                    <Label x:Name="statusText" Content="Using Windows Update servers" Foreground="Red" FontSize="16"/>
                    <ui:ProgressRing Height="20" Width="20" Margin="10,0,0,0" IsActive="False"/>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <Label Content="Windows 7/8.1 Options" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,0,0,5" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display"/>
                <CheckBox x:Name="win10UpgradeCheckbox" Content="Enable upgrade to Windows 10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,0,0,0" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
        <Label x:Name="operatingSystemLabel" Content="OS: Windows 11 Pro" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,20" FontSize="16" FontFamily="Segoe UI Variable Display"/>
    </Grid>
</Window>
